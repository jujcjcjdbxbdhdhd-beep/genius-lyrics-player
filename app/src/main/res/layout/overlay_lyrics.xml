<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/islandRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- STATE 1: MINI CAPSULE PILL -->
    <LinearLayout
        android:id="@+id/layoutIslandMini"
        android:layout_width="146dp"
        android:layout_height="34dp"
        android:background="@drawable/island_pill_bg"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <View
                android:id="@+id/eqMini1"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:background="@drawable/island_eq_bar" />

            <View
                android:id="@+id/eqMini2"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/island_eq_bar" />

            <View
                android:id="@+id/eqMini3"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/island_eq_bar" />

            <View
                android:id="@+id/eqMini4"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/island_eq_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMiniLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="♪ Остров"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/pill_sync" />
    </LinearLayout>

    <!-- STATE 2: COMPACT LIVE LYRICS PILL (DEFAULT) -->
    <LinearLayout
        android:id="@+id/layoutIslandCompact"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/island_pill_bg"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <View
                    android:id="@+id/eqCompact1"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/island_eq_bar" />

                <View
                    android:id="@+id/eqCompact2"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/island_eq_bar" />

                <View
                    android:id="@+id/eqCompact3"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/island_eq_bar" />

                <View
                    android:id="@+id/eqCompact4"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/island_eq_bar" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/compactLyricStage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true">

                <TextView
                    android:id="@+id/tvCompactLyricA"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Включите трек…"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvCompactLyricB"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnCompactToMini"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="−"
                android:textColor="#8E9398"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbCompactProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginBottom="3dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#222222"
            android:progressTint="@color/accent_spotify" />
    </LinearLayout>

    <!-- STATE 3: EXPANDED DYNAMIC ISLAND PANEL -->
    <LinearLayout
        android:id="@+id/layoutIslandExpanded"
        android:layout_width="match_parent"
        android:layout_height="404dp"
        android:background="@drawable/island_expanded_bg"
        android:elevation="20dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <!-- Header / Drag Bar -->
        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <View
                    android:id="@+id/eqExp1"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/island_eq_bar" />

                <View
                    android:id="@+id/eqExp2"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/island_eq_bar" />

                <View
                    android:id="@+id/eqExp3"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/island_eq_bar" />

                <View
                    android:id="@+id/eqExp4"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/island_eq_bar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOverlayTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:text="Живой остров"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlaySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ожидание трека..."
                    android:textColor="#9EA3A8"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnOverlayOpenApp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Открыть приложение"
                android:src="@android:drawable/ic_menu_view"
                android:tint="#B3B3B3" />

            <TextView
                android:id="@+id/btnOverlayCollapse"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="⌃"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnOverlayClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Закрыть"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#9EA3A8" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#262626" />

        <!-- Karaoke Toggle + 5 Kinetic Motion Style Picker Row -->
        <LinearLayout
            android:id="@+id/layoutOverlayMotionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOverlayKaraoke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_background"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="🎤 Караоке"
                android:textColor="#1ED760"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginHorizontal="6dp"
                android:background="#2C2C2C" />

            <HorizontalScrollView
                android:id="@+id/scrollStyleChips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnStyleFly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/pill_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="🚀 Вылет"
                        android:textColor="#B3B8BE"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnStyleFade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/pill_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="✨ Затухание"
                        android:textColor="#B3B8BE"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnStyleSlide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/pill_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="⚡ Сдвиг"
                        android:textColor="#B3B8BE"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnStylePop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/pill_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="💥 Импульс"
                        android:textColor="#B3B8BE"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnStyleTypewriter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/pill_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="⌨ Печать"
                        android:textColor="#B3B8BE"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Live Two-Line Spotlight with Clipped Dual Stage -->
        <LinearLayout
            android:id="@+id/layoutOverlayLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <FrameLayout
                android:id="@+id/expandedLyricStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:minHeight="44dp">

                <TextView
                    android:id="@+id/tvOverlayCurrentA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="Ожидание трека..."
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvOverlayCurrentB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvOverlayNextLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text=""
                android:textColor="#9EA3A8"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:id="@+id/dividerOverlayLive"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="#262626" />

        <!-- Full Lyrics Scroll View -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollOverlayLyrics"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOverlayEmptyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="4dp"
                    android:text="Ожидание трека..."
                    android:textColor="#B3B8BE"
                    android:textSize="13.5sp" />

                <LinearLayout
                    android:id="@+id/containerOverlayLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Sync & Progress Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/pbOverlayProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="#2A2A2A"
                android:progressTint="@color/accent_spotify" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOverlayTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="00:00 / --:--"
                    android:textColor="#8E9398"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnOverlaySyncBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="-0.5s"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnOverlaySyncFwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/pill_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="+0.5s"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnOverlayScroll"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Пауза синхронизации"
                    android:src="@android:drawable/ic_media_pause"
                    android:tint="#1DB954" />

                <TextView
                    android:id="@+id/btnOverlayGenius"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/pill_genius"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Genius"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
