<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="340dp"
    android:background="@drawable/overlay_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header / Drag Bar -->
    <LinearLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Spotify Lyrics"
            android:textColor="@color/accent_spotify"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Auto-sync toggle -->
        <ImageButton
            android:id="@+id/btnOverlayScroll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Синхронизация"
            android:src="@android:drawable/ic_media_pause"
            android:tint="@color/text_primary" />

        <!-- Close button -->
        <ImageButton
            android:id="@+id/btnOverlayClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Закрыть"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="@color/divider_color" />

    <!-- Spotify Live Two-Line Synced Card -->
    <LinearLayout
        android:id="@+id/layoutOverlayLive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvOverlayCurrentLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text="Ожидание трека..."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvOverlayNextLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text=""
            android:textColor="#B3B8BE"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="@color/divider_color" />

    <!-- Full Lyrics Scroll View -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOverlayLyrics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvOverlayLyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="5dp"
            android:text="Ожидание трека..."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
