<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    android:background="@drawable/overlay_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header / Drag Bar -->
    <LinearLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Spotify Lyrics"
            android:textColor="@color/accent_spotify"
            android:textSize="14sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />

        <!-- Auto-scroll toggle -->
        <ImageButton
            android:id="@+id/btnOverlayScroll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/text_primary" />

        <!-- Close button -->
        <ImageButton
            android:id="@+id/btnOverlayClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/divider_color" />

    <!-- Lyrics Scroll View -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOverlayLyrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvOverlayLyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:text="Ожидание трека..."
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
