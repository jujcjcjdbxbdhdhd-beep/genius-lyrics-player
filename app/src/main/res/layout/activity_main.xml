<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Living GPU Radial Aura Background -->
    <com.satulin.geniuslyrics.AmbientAuraView
        android:id="@+id/ambientAura"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main Player Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Notification Access Permission Banner (Shown only if permission missing) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="#D82A1412"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#FF5500"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Доступ к уведомлениям"
                    android:textColor="#FF7A33"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Разрешите доступ, чтобы автоматически считывать треки из SoundCloud, Spotify и других плееров."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF5500"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Предоставить доступ"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="19dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Obsidian Glass Hero Card: Now Playing Track Info & Progress -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FF0D1117"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardPermission"
            app:strokeColor="#1E2736"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="13dp">

                <!-- Header Row: 4-Bar Eq + Status/Source Badges + Search & Refresh Icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/eqMain1"
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:background="@drawable/island_eq_bar" />

                        <View
                            android:id="@+id/eqMain2"
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/island_eq_bar" />

                        <View
                            android:id="@+id/eqMain3"
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/island_eq_bar" />

                        <View
                            android:id="@+id/eqMain4"
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/island_eq_bar" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/glass_pill_bg"
                            android:maxLines="1"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:text="● ОЖИДАНИЕ"
                            android:textColor="@color/text_muted"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSourceBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/glass_pill_bg"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:text="Genius / Spotify"
                            android:textColor="@color/accent_spotify"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleSearch"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Ручной поиск"
                        app:icon="@android:drawable/ic_menu_search"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshLyrics"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Обновить текст"
                        app:icon="@android:drawable/ic_menu_rotate"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSongTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:maxLines="2"
                    android:text="Включите песню"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvSongArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="SoundCloud • Spotify • VK • Яндекс"
                    android:textColor="@color/text_secondary"
                    android:textSize="13.5sp" />

                <!-- Neon Gradient Progress Bar & Track Timings -->
                <ProgressBar
                    android:id="@+id/pbTrackProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="10dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_glow_drawable" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:text="00:00"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:text="--:--"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Collapsible Glass Search Bar (toggled by Search button in Hero Card) -->
        <LinearLayout
            android:id="@+id/layoutSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardNowPlaying">

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/glass_pill_bg"
                android:hint="Поиск трека со Spotify или Genius…"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualSearch"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/accent_spotify"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Найти"
                android:textColor="#000000"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <!-- 3-Segment Glass Mode Switcher (Караоке | По словам | Текст) -->
        <LinearLayout
            android:id="@+id/layoutModeTabs"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/glass_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp"
            app:layout_constraintTop_toBottomOf="@id/layoutSearch">

            <TextView
                android:id="@+id/tabKaraoke"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="🎤 Караоке"
                android:textColor="#000000"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabWordByWord"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="✨ По словам"
                android:textColor="#9DA7B5"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabPlainText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="📄 Текст"
                android:textColor="#9DA7B5"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Actions Row: Genius + Dynamic Island + Font/Top Controls -->
        <LinearLayout
            android:id="@+id/layoutQuickActions"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/layoutModeTabs">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenGeniusWeb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FFE600"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:text="Genius"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_menu_search"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="13dp"
                app:iconTint="#000000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleFloating"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#161D28"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:text="● Остров"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:strokeColor="#2E394A"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFontDown"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="A-"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFontUp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="A+"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScrollToTop"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="В начало"
                app:icon="@android:drawable/arrow_up_float"
                app:iconSize="15dp"
                app:iconTint="@color/text_secondary" />
        </LinearLayout>

        <!-- Motion Style Selector + Playback Sync Strip -->
        <FrameLayout
            android:id="@+id/layoutMotionDeck"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="7dp"
            app:layout_constraintTop_toBottomOf="@id/layoutQuickActions">

            <HorizontalScrollView
                android:id="@+id/scrollMainStyles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mainStyleFly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/glass_pill_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="🚀 Вылет"
                        android:textColor="#9DA7B5"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mainStyleFade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/glass_pill_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="✨ Затухание"
                        android:textColor="#9DA7B5"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mainStyleSlide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/glass_pill_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="⚡ Сдвиг"
                        android:textColor="#9DA7B5"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mainStylePop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/glass_pill_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="💥 Импульс"
                        android:textColor="#9DA7B5"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mainStyleTypewriter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/glass_pill_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="⌨ Печать"
                        android:textColor="#9DA7B5"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:background="#283447" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleScroll"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:backgroundTint="#18202C"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="⏸ Пауза"
                        android:textColor="@color/accent_spotify"
                        android:textSize="11sp"
                        app:cornerRadius="15dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeedDown"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="-"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="1.0x"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeedUp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvPlainTextModeLabel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glass_pill_bg"
                android:gravity="center"
                android:text="📄 Режим простого текста — тап по строке перематывает трек"
                android:textColor="#9DA7B5"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Frameless Edge-to-Edge Lyrics Stage over Living Aura -->
        <FrameLayout
            android:id="@+id/layoutLyricsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutMotionDeck">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:overScrollMode="never"
                android:paddingTop="12dp"
                android:paddingBottom="160dp"
                android:scrollbars="none" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent_spotify"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLyricsPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="Включите любую песню в SoundCloud или Spotify, и текст появится здесь."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlaceholderGeniusWeb"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="44dp"
                android:backgroundTint="#FFE600"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Открыть поиск на Genius.com"
                android:textColor="#000000"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_search"
                app:iconTint="#000000" />

            <!-- Floating Return-To-Sync Pill -->
            <TextView
                android:id="@+id/btnSyncCurrentLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:background="@drawable/pill_sync"
                android:elevation="8dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="● К ТЕКУЩЕЙ СТРОКЕ"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Full-Screen Edge-To-Edge In-App Genius Web Browser -->
    <LinearLayout
        android:id="@+id/layoutGeniusWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#06080B"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#10151D"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGeniusWebBack"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGeniusWebTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Genius.com"
                    android:textColor="#FFE600"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReloadGeniusWeb"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Обновить"
                    app:icon="@android:drawable/ic_menu_rotate"
                    app:iconTint="#9DA7B5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExternalBrowserGenius"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Открыть в браузере"
                    app:icon="@android:drawable/ic_menu_compass"
                    app:iconTint="#FFE600" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseGeniusWeb"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Закрыть"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etGeniusWebQuery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/glass_pill_bg"
                    android:hint="Поиск песни на Genius..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGeniusWebSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#FFE600"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Найти"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="19dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJumpToGeniusSong"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#2D2B14"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:text="⚡ Открыть страницу трека напрямую →"
                android:textColor="#FFE600"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbGeniusWeb"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminateTint="#FFE600"
            android:progressTint="#FFE600" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webViewGeniusPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportFromGeniusWeb"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:backgroundTint="@color/accent_spotify"
                android:elevation="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="20dp"
                android:text="⚡ Загрузить этот текст в плеер"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="22dp" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
