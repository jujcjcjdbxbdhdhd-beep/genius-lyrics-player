<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- Notification Access Permission Banner (Shown only if permission missing) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#2A1715"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#FF5500"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Доступ к уведомлениям"
                android:textColor="#FF7A33"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Разрешите доступ, чтобы автоматически считывать треки из SoundCloud, Spotify и других плееров."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantPermission"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF5500"
                android:text="Предоставить доступ"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Top Spotify Card: Now Playing Track Info & Progress -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardPermission"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status Badges row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_background"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● ОЖИДАНИЕ ТРЕКА"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSourceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_background"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Spotify Lyrics"
                    android:textColor="@color/accent_spotify"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Genius Web button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGeniusWeb"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#FFFF64"
                    android:text="Текст с Genius"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp"
                    app:icon="@android:drawable/ic_menu_search"
                    app:iconSize="14dp"
                    app:iconTint="#000000" />

                <!-- Floating overlay icon -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleFloating"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:icon="@android:drawable/ic_menu_crop"
                    app:iconTint="@color/accent_spotify" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="2"
                android:text="Включите песню"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="SoundCloud • Spotify • VK • Яндекс"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Spotify Progress Bar & Track Timings -->
            <ProgressBar
                android:id="@+id/pbTrackProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/accent_spotify"
                android:progressBackgroundTint="#333333" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="00:00"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="--:--"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sleek Spotify Search Bar -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardNowPlaying">

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:hint="Поиск трека со Spotify или Genius…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualSearch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_spotify"
            android:text="Найти"
            android:textColor="#000000"
            android:textStyle="bold"
            app:cornerRadius="22dp" />
    </LinearLayout>

    <!-- Interactive Auto-Scroll & Controls Bar -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSearch">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleScroll"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/bg_chip"
            android:text="⏸ Пауза"
            android:textColor="@color/accent_spotify"
            android:textSize="12sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeedDown"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:text="-"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeedUp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="+"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontDown"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="A-"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontUp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="A+"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScrollToTop"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:icon="@android:drawable/arrow_up_float"
            app:iconTint="@color/text_secondary" />
    </LinearLayout>

    <!-- Spotify Lyrics View Container -->
    <FrameLayout
        android:id="@+id/layoutLyricsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_background"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutControls">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="32dp"
            android:paddingBottom="160dp"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_spotify"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLyricsPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="28dp"
            android:text="Включите любую песню в SoundCloud или Spotify, и текст появится здесь."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlaceholderGeniusWeb"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="72dp"
            android:backgroundTint="#FFFF64"
            android:text="Открыть на сайте Genius"
            android:textColor="#000000"
            android:textStyle="bold"
            app:cornerRadius="22dp"
            app:icon="@android:drawable/ic_menu_search"
            app:iconTint="#000000"
            android:visibility="gone" />

        <!-- Floating Spotify Return-To-Sync Pill (appears when manually scrolling) -->
        <TextView
            android:id="@+id/btnSyncCurrentLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/pill_sync"
            android:elevation="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="● К ТЕКУЩЕЙ СТРОКЕ"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <!-- In-App Genius Web Browser Sheet -->
    <LinearLayout
        android:id="@+id/layoutGeniusWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/card_background"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Browser Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#202020"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseGeniusWeb"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconTint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGeniusWebTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Genius.com"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGeniusWebSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Официальный текст песни"
                    android:textColor="#FFFF64"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReloadGeniusWeb"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@android:drawable/ic_menu_rotate"
                app:iconTint="#B3B3B3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExternalBrowserGenius"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@android:drawable/ic_menu_compass"
                app:iconTint="#FFFF64" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbGeniusWeb"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminateTint="#FFFF64"
            android:progressTint="#FFFF64" />

        <WebView
            android:id="@+id/webViewGeniusPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
